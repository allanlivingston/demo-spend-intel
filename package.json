{
  "name": "claude-spend-intelligence",
  "version": "1.0.6",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "start": "NEXT_DIST_DIR=.next-build next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "record": "tsx --tsconfig tsconfig.json scripts/record.ts",
    "walk": "tsx scripts/walk.ts",
    "eval": "tsx --tsconfig tsconfig.json scripts/eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "@anthropic-ai/sdk": "^1.12.0",
    "lucide-react": "^1.77.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.11.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
