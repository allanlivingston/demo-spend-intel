# Which agent backend runs. Default: claude-code in development (your Claude Code login, no API tokens),
# api in production when ANTHROPIC_API_KEY is set, otherwise replay.
# AGENT_BACKEND=claude-code | api | replay

# Production (Vercel) only. Not needed locally: the claude-code backend strips it anyway.
# ANTHROPIC_API_KEY=

# Live API safeguards (in-memory, per server instance)
# SESSION_RUN_LIMIT=50
# DAILY_SPEND_CAP_USD=5

# Optional passcode gate: when set, visitors must enter it before using the app. Leave blank to skip.
# APP_PASSCODE=
